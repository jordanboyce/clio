# Clio static search: settings for Apache. Other web servers ignore this file.

# Types some servers do not know: without them the browser refuses the
# WebAssembly runtime, and some servers refuse the files outright.
AddType application/wasm .wasm
AddType application/octet-stream .onnx .bin
AddType text/javascript .js .mjs
AddType application/json .json
# What an export's additions write.
AddType "text/csv; charset=utf-8" .csv
AddType "text/tab-separated-values; charset=utf-8" .tsv
AddType "text/markdown; charset=utf-8" .md
AddType text/vtt .vtt
AddType application/manifest+json .webmanifest
AddType application/epub+zip .epub
AddType "application/x-bibtex; charset=utf-8" .bib
AddType application/octet-stream .npy
AddType "application/jsonl; charset=utf-8" .jsonl

<IfModule mod_headers.c>
  # The manifest names every other file with its checksum, so it is read
  # fresh on each visit; the files it names may be cached.
  <Files "manifest.json">
    Header set Cache-Control "no-cache"
  </Files>
  <FilesMatch "\.(wasm|onnx)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # To let pages on another site load this search, remove the # below.
  # Header set Access-Control-Allow-Origin "*"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/javascript application/wasm text/html text/css text/csv text/markdown text/vtt application/xml
</IfModule>
