# Docker Compose publishes to loopback by default. For protected LAN access,
# explicitly choose the host interface and configure auth / trusted ingress
# (`python scripts/setup.py` sets this together with AUTH_PASSWORD).
# BIND_ADDRESS=127.0.0.1

# Clio API Configuration

# Data storage directory (where documents and indexes are stored)
DATA_DIR=./data

# Where documents and queries are turned into search vectors. All of this is
# also editable under Settings → Indexing → Embedding, which is the easier
# path; values saved there persist in the app database and override .env.
#
#   local              built in, runs on this server's CPU, free (default)
#   google             Google Gemini — free tier, key from AI Studio
#   mistral | voyage | jina
#                      hosted APIs with free tiers; each needs its own key
#   openrouter         one key, dozens of models, a few of them free
#                      (rate-limited); reuses the OpenRouter chat key
#   openai             paid, low cost; reuses the OpenAI chat key
#   ollama             a self-hosted Ollama daemon at OLLAMA_BASE_URL
#   openai_compatible  any OpenAI-style /embeddings endpoint (EMBEDDING_BASE_URL)
#
# Hosted providers receive document text at index time and queries at search
# time. Changing the provider or model means re-indexing every collection.
EMBEDDING_PROVIDER=local

# Model for EMBEDDING_PROVIDER=local (any sentence-transformers name).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Model for every other provider; blank = that provider's recommended model
# (gemini-embedding-001, mistral-embed, voyage-3.5-lite, jina-embeddings-v3,
# nvidia/nemotron-3-embed-1b:free, text-embedding-3-small, nomic-embed-text).
# OLLAMA_EMBEDDING_MODEL is the old name and still works.
REMOTE_EMBEDDING_MODEL=

# Key for the selected embedding provider. Blank = reuse the team key saved
# under Settings → AI Providers for Google / OpenAI / OpenRouter. Mistral,
# Voyage and Jina have no chat card, so set this (or enter it in Settings).
EMBEDDING_API_KEY=

# Only for EMBEDDING_PROVIDER=openai_compatible, e.g. http://lmstudio:1234/v1
EMBEDDING_BASE_URL=

# Local cross-encoder reranker: reorders the best candidates of every search
# (UI, API and MCP alike) with a small model that runs in-process; nothing
# leaves the machine. Unset = automatic: on whenever the model is on disk.
# The Docker image bakes it; a connected install fetches it once at startup.
# true forces it on (may download on first use), false turns it off.
#ENABLE_RERANKER=
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# auto picks fastembed (ONNX, no PyTorch, installed with the core
# requirements) when it has the model, else sentence-transformers.
RERANKER_BACKEND=auto
# Candidates scored per search = top_k x this (cost is linear in the pool).
# scripts/retrieval_bench.py measures the trade-off; 2x/3x/5x ranked its
# corpus identically at p50 315/500/792 ms, so 5x only costs.
RERANKER_CANDIDATE_MULTIPLIER=3
# Reranking passes in flight at once; a search that waits longer than the
# timeout for a slot answers in retrieval order (the response says so).
# Benchmarked under eight parallel callers: 2 doubled throughput over 0.
RERANK_MAX_CONCURRENT=2
RERANK_QUEUE_TIMEOUT_SECONDS=1

# ── The LLM this deployment uses ────────────────────────────────────────
# Leave AI_PROVIDER empty for the bring-your-own-key behaviour: each person
# connects a provider in Settings, and it lives in their browser. That fits a
# laptop install; it does not fit an appliance, where the model belongs to
# the organisation and nobody should be typing an internal URL into a form.
#
# Set these and the whole deployment uses one model with no per-person setup
# — chat, report generation, OCR of scanned pages and images, and the
# content-policy reviewer. The UI shows it as an already-connected provider.
# A per-request key still overrides it, so someone can bring their own.
#
#   openai_compatible   any OpenAI-shaped server you run — vLLM, LM Studio,
#                       llama.cpp, TGI, LiteLLM, Ollama's /v1, a gateway
#   ollama              an Ollama daemon over its native API
#   anthropic | openai | google | grok | github | openrouter | ollama_cloud
#                       a hosted provider (blocked by OFFLINE_MODE)
#
# AI_BASE_URL is required for openai_compatible — the app refuses to start
# without it. Full walkthrough, including private CAs: docs/ONPREM.md.
AI_PROVIDER=
AI_BASE_URL=          # e.g. http://vllm.internal:8000/v1
AI_MODEL=             # e.g. llama-3.3-70b-instruct
AI_API_KEY=           # empty is fine for an endpoint that needs no auth
AI_PROVIDER_LABEL=    # what the UI calls it, e.g. "Acme Internal LLM"

# Ollama daemon, used by AI_PROVIDER=ollama, Ollama-served embeddings and
# local vision OCR. Inside Docker, the host is host.docker.internal — not
# localhost, which is the container itself.
OLLAMA_BASE_URL=http://localhost:11434

# Text chunking configuration
CHUNK_SIZE=550
CHUNK_OVERLAP=100

# Search configuration
DEFAULT_TOP_K=10
MAX_TOP_K=50

# Server configuration.
#
# HOST=127.0.0.1 (the default) accepts connections from this machine only.
# There is NO app authentication unless AUTH_PASSWORD or AUTH_REQUIRE_IDENTITY
# is set below, so anyone who
# can reach this port can read, modify and delete every document, and spend
# your AI provider credits. Before changing this to 0.0.0.0 to reach the app
# from other machines, set AUTH_PASSWORD or put a verified identity proxy in
# front. Docker sets HOST=0.0.0.0 itself —
# there the container's published port is what controls exposure.
HOST=127.0.0.1
PORT=8473

# Dev only: auto-restart the server on code changes. Leave off in normal use —
# the reloader runs the server as a child process, and a hard kill of the
# parent (task manager, closed terminal) would orphan it on the port.
RELOAD=false

# Deployment profile: standard (default) or secure. Secure defaults OFFLINE_MODE
# on, MCP_AUDIT_TOOL_CALLS on and LINK_INDEXING_ENABLED off, and refuses to
# start when reachable without authentication or pointed at a hosted model.
# An explicit value below beats the profile: with CLIO_PROFILE=secure, leave
# OFFLINE_MODE unset or true. Prove the result with scripts/preflight.py.
# See docs/SECURE_PROFILE.md.
CLIO_PROFILE=standard

# Air-gapped / offline mode. Disables cloud AI providers (only local Ollama
# and self-hosted OpenAI-compatible endpoints remain) and all HuggingFace
# downloads (models load from the local cache only). See docs/AIRGAP.md.
OFFLINE_MODE=false

# Allowed browser origins for CORS, comma-separated ("*" = any). Empty (the
# default) sends no CORS headers, so only pages on this same origin can read
# responses — which is all the bundled frontend and the Vite dev proxy need.
# Non-browser clients (MCP, curl, SDKs) ignore CORS entirely. Set this only
# for a separate web app on another origin, and list that origin rather than
# using "*": with "*" and no AUTH_PASSWORD, any page the user visits can read
# this API from their browser. Credentialed cross-origin requests require an
# explicit origin list — the wildcard never allows credentials.
CORS_ALLOW_ORIGINS=

# Shared-secret auth. Optional: leave it empty on a machine only you use, and
# the app asks for nothing. Required whenever the app is reachable beyond this
# machine (HOST=0.0.0.0, Docker's published port, a PaaS domain). When set,
# every request except /health requires this password — browsers prompt
# natively (HTTP Basic, any username); API/MCP clients send it as
# `Authorization: Bearer <password>`. `python scripts/setup.py` sets this,
# HOST and BIND_ADDRESS together from one question.
AUTH_PASSWORD=
# Require a verified identity (see IDENTITY_PROVIDER below) on every request.
AUTH_REQUIRE_IDENTITY=false

# Multi-user mode is NOT supported — the app refuses to start with it enabled.
# The old flag only filtered the collection list without enforcing anything.
# For per-person collections, use PRIVATE_COLLECTIONS below instead.
ENABLE_MULTI_USER=false

# Private collections: collections belong to the person who created them and
# are invisible to everyone else until shared. Clio has no accounts of its
# own, so this only makes sense behind your organisation's sign-in
# (IDENTITY_PROVIDER below); the app refuses to start with it on and no
# identity source. Leave it off for a personal or small-team install.
# See docs/IDENTITY.md.
PRIVATE_COLLECTIONS=false

# ── Verified identity (docs/IDENTITY.md) ─────────────────────────────────
# Who a request is, and optionally whether it gets in at all
# (AUTH_REQUIRE_IDENTITY=true).
# Empty (the default) = no verified identity: an open appliance, which is
# what you want on a machine only you reach. Add AUTH_PASSWORD above when
# others can reach the port. Only for organisations that already run sign-in:
#
#   oidc               a bearer JWT from your own IdP - Keycloak, Entra ID,
#                      Okta, PingFederate. The on-prem / air-gapped answer.
#   trusted_header     a header set by an authenticating reverse proxy:
#                      mTLS terminator, Kerberos front end, site SSO proxy.
#
# A configuration that cannot be enforced is a startup failure, never a
# silent downgrade to "everyone is anonymous".
IDENTITY_PROVIDER=
# IDENTITY_PROVIDER=oidc. OIDC_AUDIENCE is mandatory: without it, any token
# your IdP ever issued for any application would be accepted here.
# OIDC_JWKS_URL skips discovery when the issuer's .well-known document is
# unreachable. OIDC_REQUIRED_CLAIMS gates admission on a claim, e.g. one IdP
# group: comma-separated name=value pairs, matching a scalar or a list member.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_IDENTITY_CLAIM=email
OIDC_REQUIRED_CLAIMS=

# ── OAuth 2.1 for MCP clients (docs/IDENTITY.md) ─────────────────────────
# Claude Desktop, claude.ai, ChatGPT and Claude Code sign in at your IdP and
# present the token on /mcp. With IDENTITY_PROVIDER=oidc nothing more is
# needed than MCP_PUBLIC_URL — the URL clients reach the endpoint at, which
# is the RFC 9728 resource and an accepted token audience (RFC 8707).
# MCP_OAUTH_* name a different IdP for /mcp only (a trusted-proxy deployment,
# whose browser identity is not a bearer JWT). MCP_OAUTH_SCOPE
# makes tokens carry a scope; leave empty unless your IdP defines one.
MCP_PUBLIC_URL=
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_SCOPE=

# IDENTITY_PROVIDER=trusted_header. The header is forgeable by anything that
# can reach the port, so one real guard is mandatory: either HOST is loopback
# (your proxy is the only route in) or TRUSTED_HEADER_SECRET is set and the
# proxy signs the identity with HMAC-SHA256, hex-encoded, in
# TRUSTED_HEADER_SIGNATURE_NAME. TRUSTED_HEADER_PROXIES is defence in depth
# only — uvicorn can rewrite the peer address from X-Forwarded-For.
TRUSTED_HEADER_NAME=X-Forwarded-User
TRUSTED_HEADER_PROXIES=
TRUSTED_HEADER_SECRET=
TRUSTED_HEADER_SIGNATURE_NAME=X-Forwarded-User-Signature

# OCR (scanned PDFs) and image indexing — usually configured in the Settings
# tab instead. A vision-capable model gives the best results: scanned pages
# are read per-page (including lone scanned pages inside texty documents),
# and uploaded images (PNG/JPG/WEBP/TIFF...) are described + transcribed so
# pictures are searchable by content. Local Docling/Tesseract remains the
# no-network fallback (requires `pip install -r requirements-ocr.txt`; the
# Docker image ships ready) — it recovers printed text but can't describe
# pictures.
ENABLE_OCR=false
VISION_OCR_PROVIDER=none   # none | auto (local Ollama) | ollama | ollama_cloud | anthropic | openai | ...
VISION_OCR_MODEL=          # vision-capable model; empty with auto/ollama = auto-detect
VISION_OCR_API_KEY=        # optional: ollama_cloud reuses OLLAMA_CLOUD_API_KEY/TOKEN or the saved team key
# Cost guards for OCR of large documents (0 = no limit)
OCR_MAX_PAGES=25
OCR_MAX_FILE_MB=50

# Share invitations by email (Resend, https://resend.com). With a key set,
# the share dialog can email a recipient the share token plus a join link
# that prefills it. RESEND_FROM must be a sender on a domain verified in
# your Resend account; the default onboarding sender only delivers to the
# Resend account owner's address (testing only). Disabled in OFFLINE_MODE.
RESEND_API_KEY=
RESEND_FROM=Clio <onboarding@resend.dev>

# Operator allowlist, comma-separated: names the admins when identity comes
# from oidc / trusted_header. Empty means nobody, so deployment-wide settings
# fail closed on a deployment with private collections.
ADMIN_EMAILS=

# ── Storage ─────────────────────────────────────────────────────────────
# Most a single collection may hold, as the sum of its source files
# (uploads, staged copies, in-place references, agent-written sources).
# Every ingest path refuses a file that would cross it, with a 413 that
# carries the numbers; the Sources panel shows usage. 0 = unlimited.
# Default 5 GiB (5368709120).
COLLECTION_STORAGE_LIMIT_BYTES=5368709120

# ── Load protection ─────────────────────────────────────────────────────
# Per-identity limits so one person cannot starve everyone else on a shared
# deployment. Identity = the signed-in person when there is one, else the
# client IP. 0 disables the individual limit; RATE_LIMIT_ENABLED=false
# disables request limiting entirely.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=6
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=120
# Agent traffic on /mcp: per personal token, 0 = unlimited (recommended for a
# private deployment — agents fan out tool calls and handle 429s badly).
RATE_LIMIT_MCP_PER_MINUTE=0
# Worker threads shared by MCP tool calls, chat turns, uploads and document
# reads: how many run at once before callers queue. Threads are cheap when
# idle; CPU is the real ceiling. A chat turn holds one for its whole loop.
WORKER_THREADS=64
# research_documents runs several searches per call; parallel calls queue for
# one of these slots instead of slowing each other down. 0 = no gate.
RESEARCH_MAX_CONCURRENT=3
RESEARCH_QUEUE_TIMEOUT_SECONDS=60

# Provider tokens (input+output) one identity may spend on chat per UTC day.
# 0 = unlimited. Cached answers stay free once the budget is spent, so a
# capped user still gets instant answers to already-asked questions. With a
# shared free-tier key, something like 200000 is a sane team ceiling.
CHAT_DAILY_TOKEN_BUDGET=0

# Indexing jobs allowed to run at once across ALL collections (each one
# competes for the same embedding lock live search uses).
MAX_CONCURRENT_INDEX_JOBS=2

# Retention, in days. Search history stores result snippets (privacy
# liability if kept forever); usage rows are what the admin dashboard reads.
SEARCH_HISTORY_RETENTION_DAYS=30
USAGE_RETENTION_DAYS=180

# ── Content governance ──────────────────────────────────────────────────
# Every document is scanned when it is added (local regex rule packs:
# child-abuse-material indicators, attack planning, weapons and drug
# trade, explicit content, credential dumps, secrets). What happens when
# the scan flags something:
#   off        — do not scan
#   flag       — index it and show a badge (default, same posture as the
#                prompt-injection scan)
#   quarantine — index it but hide it from search, chat and MCP until an
#                admin approves it in the Admin tab
#   reject     — refuse to index it
# Critical findings are always at least quarantined, even on "flag".
# Attribution (who added what), the audit trail, the report button and the
# admin hash blocklist are always on and need no setting.
CONTENT_POLICY_ACTION=flag

# What the prompt-injection text scan does with what it finds. The scan is
# wording-based and can misread ordinary prose ("act as a fiduciary",
# "including without limitation"), so this is adjustable without losing the
# badge on the source:
#   review — badge the source and queue medium/high verdicts for an admin
#   warn   — badge the source only; never add it to the admin queue
#   off    — do not scan
# A reviewed warning stays on the source (so the decision is visible) but
# leaves the queue, and a re-index of the same bytes does not reopen it.
INJECTION_SCAN_ACTION=review

# Personal data (PII) in sources. Microsoft Presidio when installed
# (pip install -r requirements-pii.txt), a built-in regex set otherwise;
# nothing leaves the machine. A page counts as personal data when it holds
# at least PII_FLAG_THRESHOLD entities, so a signature block never trips it.
#   off        — do not scan
#   label      — record the finding, default the document to confidential,
#                never queue it (the default)
#   flag       — also queue it for admin review, like a content-scan flag
#   quarantine — hide it from search, chat and MCP until an admin approves
# PII_ENTITIES narrows or widens the Presidio entity list (comma-separated;
# blank = EMAIL_ADDRESS, PHONE_NUMBER, CREDIT_CARD, IBAN_CODE, US_SSN,
# US_PASSPORT, US_DRIVER_LICENSE, US_BANK_NUMBER, UK_NHS, IP_ADDRESS).
# PII_REDACT_OUTPUTS=true masks personal data in search results, chat
# context and sources, MCP excerpts and chunk views (the stored file is
# untouched).
PII_SCAN_ACTION=label
PII_FLAG_THRESHOLD=10
PII_ENTITIES=
PII_REDACT_OUTPUTS=false

# Optional second opinion from the LLM already configured for chat: a
# sample of pages is classified against the same categories. Costs tokens
# per upload and sends content to that provider, so it is off by default.
# Its verdict can escalate a document; it never clears a rule-pack finding.
CONTENT_POLICY_LLM_REVIEW=false
CONTENT_POLICY_LLM_PROVIDER=     # blank = the default chat provider
CONTENT_POLICY_LLM_MODEL=
CONTENT_POLICY_LLM_SAMPLE_PAGES=6

# Acceptable-use acknowledgement: each identity must accept the policy
# (once per version) before adding sources; bump the version to re-prompt
# everyone. Recorded per identity, so it only takes effect under
# PRIVATE_COLLECTIONS. Blank text uses the built-in policy (markdown).
AUP_REQUIRED=false
AUP_VERSION=1
AUP_TEXT=

# Audit events (uploads, deletions, shares, tokens, policy decisions, admin
# actions) — the accountability trail. 0 keeps them forever.
AUDIT_RETENTION_DAYS=365

# Semantic answer cache — repeated single-turn chat questions that closely
# match an already-answered one return the stored answer instead of spending
# provider tokens (similarity is computed with the LOCAL embedding model; the
# lookup never calls an API). Entries are invalidated when any source document
# the answer cited changes, and the chat UI's "Fresh answer" button bypasses
# and replaces an entry. Answers reflect the corpus as of generation time:
# newly added documents don't evict old answers until sources change or the
# answer is regenerated. Questions that differ in numbers or negation never
# share an answer, whatever the threshold.
ENABLE_ANSWER_CACHE=true
ANSWER_CACHE_THRESHOLD=0.9      # default similarity to count as the same question;
                                # each user can adjust it in Chat Settings (1.0 = identical text only)
ANSWER_CACHE_MAX_PER_SCOPE=200  # LRU cap per collection/scope

# CSV Indexing Configuration
CSV_ROW_LEVEL_INDEXING=true  # Index CSV rows individually for better search

# MCP server
ENABLE_MCP=true
MCP_SERVER_ID=clio
MCP_DEFAULT_COLLECTION=default
MCP_TOP_K=8
# auto (default) blends meaning and keywords and tunes the balance per query;
# semantic | keyword | hybrid force one strategy. Leave it on auto.
MCP_MODE=auto
MCP_SEMANTIC_WEIGHT=0.7
MCP_INCLUDE_SOURCES=true
MCP_MAX_SOURCE_LENGTH=500
MCP_AI_PROVIDER=none
MCP_OLLAMA_MODEL=gemma3n

# Record every MCP tool call in the audit trail, not just writes — the
# "which credential read which document, when" question a regulated or
# government deployment has to answer. Off by default because on a personal
# appliance it is noise. Metadata only: tool, credential, collection,
# documents and result counts, never the passage text.
MCP_AUDIT_TOOL_CALLS=false

# Git repositories as sources. A local checkout is read with `git ls-files`
# (.gitignore honoured). Remote repositories are shallow-cloned under
# DATA_DIR/repos and followed. GIT_ALLOWED_HOSTS is the allowlist (comma
# separated, "*.corp.example" allowed): when set, ONLY these hosts can be
# cloned, private addresses included, which is how an internal git server is
# reached. Empty = public hosts only, and OFFLINE_MODE refuses remote clones.
# Never put credentials in a repository address: use GIT_HTTP_TOKEN (over
# https, and only ever to a host listed in GIT_ALLOWED_HOSTS, since anyone who
# can add a source can type an address) or an ssh key on the server.
GIT_ALLOWED_HOSTS=
# GIT_HTTP_USER=x-access-token
# GIT_HTTP_TOKEN=

# Change alerts. "Watch" on a source re-checks it every SOURCE_WATCH_DEFAULT_MINUTES
# (or its own interval); changes appear in the Updates bell and the MCP
# list_changes tool. Set ALERT_WEBHOOK_URL to also POST each change as JSON
# (Slack/Teams/ntfy/any internal endpoint); ALERT_WEBHOOK_SECRET signs the body
# (X-Clio-Signature: sha256=<hmac>). SOURCE_WATCH_TICK_SECONDS=0 turns watching off.
SOURCE_WATCH_TICK_SECONDS=60
SOURCE_WATCH_DEFAULT_MINUTES=15
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# Link indexing: User-Agent sent when fetching pasted links (empty = built-in,
# which carries the project URL as Wikimedia requires).
LINK_USER_AGENT=

# Research workspace (docs/RESEARCH.md): paper and book metadata and reference
# resolution consult OpenAlex, Crossref, arXiv and Open Library by an identifier printed in
# the source (identifiers and cited titles only, never passages). Off in
# OFFLINE_MODE. The contact email is sent as those services ask.
RESEARCH_LOOKUP_ENABLED=true
RESEARCH_CONTACT_EMAIL=
RESEARCH_MAX_JOB_DOCUMENTS=200
RESEARCH_MAX_CONCURRENT_JOBS=1
