# Docker
.docker/

# SSL Certificates. certs/ holds a dev self-signed pair if you generate one;
# certs/ca/ is the drop-zone for corporate CA bundles that the Docker build
# installs into the system trust store. Both dir markers stay tracked so the
# Dockerfile's COPY always has something to copy.
certs/*
!certs/.gitkeep
!certs/ca/
certs/ca/*
!certs/ca/.gitkeep

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

